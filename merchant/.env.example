# TheMerchant runtime settings. Copy to .env (gitignored) or set them in your host's
# secret store. Never commit real values.
MERCHANT_DISCORD_TOKEN=
DISCORD_GUILD_ID=1554075315104514120
MERCHANT_APPLICATION_ID=1554254355644026910
# Your Discord user id: becomes the first Executive on startup.
OWNER_DISCORD_ID=
# PostgreSQL 16, e.g. a Supabase connection string (use the pooler URL in session mode).
DATABASE_URL=
# For Supabase, TLS and its root certificate (certs/supabase-root-2021.crt) are
# used automatically. Only set these for another Postgres provider.
# DATABASE_SSL=true
# DATABASE_SSL_CA=
# 32 random bytes, hex or base64 (openssl rand -hex 32). Encrypts provider payout details.
PAYOUT_ENC_KEY=
# Marketplace connection (Q8). Leave the secret empty to stay in manual-import mode.
MARKETPLACE_NAME=marketplace
MARKETPLACE_WEBHOOK_SECRET=
MARKETPLACE_API_BASE=
MARKETPLACE_API_KEY=
PORT=8080
LOG_LEVEL=info
# Optional: split processes. With none set, one process runs bot + API + worker.
# RUN_BOT=true
# RUN_API=true
# RUN_WORKER=true
